# === WAJIB DIISI SEBELUM DEPLOY ===

# Kredensial database. Dipakai container db sekaligus menyusun DATABASE_URL.
POSTGRES_USER=devfest
POSTGRES_PASSWORD=ganti-dengan-password-kuat
POSTGRES_DB=devfest

# Kunci penandatangan token. Minimal 32 byte — lebih pendek ditolak aplikasi.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Domain frontend produksi. Tanpa ini semua request dari browser diblokir.
BACKEND_CORS_ORIGINS=https://domain.com


# === OPSIONAL — fitur mati kalau kosong, aplikasi tetap jalan ===

# Chatbot. Tanpa ini chat menolak dengan pesan jelas, API tetap normal.
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# Notifikasi Telegram. Tanpa ini notifikasi tercatat `failed`, deteksi
# anomali tetap berjalan.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=


# === PENYETELAN — biarkan default kalau belum yakin ===

JWT_EXPIRE_MINUTES=1440

# Ambang deviasi anomali. Simulasi 20 orang sehat selama setahun: nilai 2.0
# menghasilkan 1 alert palsu tiap ~23 hari sambil tetap menangkap lonjakan
# sekelas kopi; 2.5 menurunkannya jadi tiap ~83 hari tapi efek kopi lolos.
ANOMALY_ZSCORE_THRESHOLD=2.0

# Minimal rentang hari data sebelum anomali mulai aktif (PRD A3).
BASELINE_COLD_START_DAYS=14


# === PENGEMBANGAN LOKAL (tanpa Docker) ===
# Di Docker, DATABASE_URL dan VIDEO_STORAGE_PATH sudah diatur compose.
#
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/devfest
# VIDEO_STORAGE_PATH=./data/videos
# Startup memuat model rPPG ~20 detik; matikan untuk iterasi cepat.
# WARM_UP_RPPG_ON_START=false
