# --- Application ---
APP_NAME=Family Health Monitor
ENVIRONMENT=local

# --- Database ---
# Postgres with TimescaleDB + pgvector extensions (see README setup).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/devfest

# --- Auth (REQUIRED) ---
# No default. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440

# --- Video storage (PRD A1: VPS filesystem) ---
VIDEO_STORAGE_PATH=./data/videos

# --- External services ---
# Required only once the chatbot (Phase 5) is enabled.
DEEPSEEK_API_KEY=
# Required only once Telegram notifications (Task 15) are enabled.
TELEGRAM_BOT_TOKEN=

# --- CORS ---
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Anomaly detection (PRD §13 open item: per-metric tuning still to be decided) ---
ANOMALY_ZSCORE_THRESHOLD=2.0
BASELINE_COLD_START_DAYS=14
